# OceanEye environment template. PLACEHOLDERS ONLY - copy to .env and edit. Never commit .env.
# All variables use the OCEANEYE_ prefix.
#
# Anything marked "auto" or 0 is decided from this machine at startup (GPU/CPU memory). Setting a
# value here overrides that one field only - so you can pin the model and still let the image size
# be chosen for you.

OCEANEYE_ENVIRONMENT=development        # development | test | production
OCEANEYE_LOG_LEVEL=INFO
OCEANEYE_LOG_JSON=false

# API / CORS (comma-separated origins; "*" is rejected in production)
OCEANEYE_API_PREFIX=/api
OCEANEYE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------- HTTPS
# Phones need a secure origin to install the app and to receive alerts while it is closed.
# Generate a self-signed pair covering localhost and this PC's Wi-Fi address:
#     python scripts/make_certs.py
# then uncomment the two lines it prints. Leave them unset to run plain HTTP.
# OCEANEYE_SSL_CERTFILE=./data/certs/cert.pem
# OCEANEYE_SSL_KEYFILE=./data/certs/key.pem

# Persistence (SQLite for the prototype; a PostgreSQL URL works unchanged)
OCEANEYE_DATABASE_URL=sqlite:///./data/oceaneye.db

# Evidence storage (local disk for the prototype)
OCEANEYE_EVIDENCE_DIR=./data/evidence

# Security. auth_mode=dev trusts X-Dev-Role headers and is REFUSED in production.
OCEANEYE_AUTH_MODE=dev                  # dev | token (token auth is a placeholder)
# OCEANEYE_SECRET_KEY=<set-a-long-random-value-outside-source-control>

# ---------------------------------------------------------------- alerts
# Implemented: websocket, mock, web_push. Boundary only: sms
OCEANEYE_NOTIFICATION_CHANNELS=websocket,mock

# Background phone alerts (Web Push). Generate the keys with:
#     python scripts/make_push_keys.py
# then add web_push to the channels above. Needs HTTPS. The private key is a SECRET.
# OCEANEYE_VAPID_PUBLIC_KEY=
# OCEANEYE_VAPID_PRIVATE_KEY=./data/vapid_private.pem
# OCEANEYE_VAPID_SUBJECT=mailto:you@example.com

# Alert / escalation (PROPOSED SCAFFOLD placeholders - experimental parameters)
OCEANEYE_ACK_TIMEOUT_SECONDS=30
OCEANEYE_ESCALATION_MONITOR_ENABLED=true
OCEANEYE_ESCALATION_CHECK_INTERVAL_SECONDS=5

# ---------------------------------------------------------------- the beach
# In the field OceanEye watches ONE beach, run by that beach's authority. These values create that
# beach the first time the system starts; after that it lives in the database and you change it in
# the Control Room ("Change beach"). Editing them later does not move an existing deployment.
OCEANEYE_DEFAULT_REGION=Karnataka, India
OCEANEYE_DEFAULT_LOCATION_NAME=Tannirbhavi Beach, Mangaluru
OCEANEYE_DEFAULT_LAT=12.8406
OCEANEYE_DEFAULT_LON=74.8016
OCEANEYE_BEACH_AUTHORITY_NAME=Beach authority (configure in .env)
# OCEANEYE_BEACH_AUTHORITY_PHONE=+91 ...
OCEANEYE_EMERGENCY_PHONE=112

# Environmental data: Open-Meteo forecast + marine (free, no key) and OpenStreetMap beaches.
# Set either to "mock" to work fully offline.
OCEANEYE_WEATHER_PROVIDER=open_meteo    # open_meteo | mock

# ---------------------------------------------------------------- places & map
# One Geoapify key powers both place search and map tiles. Get a free one at
# https://myprojects.geoapify.com. Without it the map is blank and you type the beach in by hand;
# everything else still works.
#
# The key is a SECRET. Searches run server-side and tiles are proxied through
# /api/map/tiles/..., so it is never sent to the browser. Do not paste it into a web page.
OCEANEYE_PLACES_PROVIDER=geoapify       # geoapify | mock
# OCEANEYE_GEOAPIFY_API_KEY=<your key>
OCEANEYE_MAP_STYLE=osm-bright-smooth    # any Geoapify raster style (osm-carto, positron, ...)
OCEANEYE_MAP_MAX_ZOOM=19
# Satellite needs no key, so it is fetched directly by the browser.
OCEANEYE_MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
OCEANEYE_MAP_SATELLITE_ATTRIBUTION=Imagery &copy; Esri

# ---------------------------------------------------------------- video processing
# Each worker = one process with its own model. Leave these on auto unless you have a reason:
# two workers at a large image size is what used to exhaust a 4 GB laptop GPU.
OCEANEYE_MAX_WORKERS=0                  # 0 = auto (sized from GPU/CPU memory)
OCEANEYE_WORKER_MODEL=auto              # auto | yolov8n.pt | yolov8s.pt | yolov8m.pt | yolo11s.pt
OCEANEYE_WORKER_IMGSZ=0                 # 0 = auto; larger helps distant swimmers, costs speed
OCEANEYE_WORKER_DEVICE=auto             # auto | cpu | cuda:0 | mps
OCEANEYE_WORKER_TARGET_FPS=0            # 0 = auto; frames analysed per second per camera
OCEANEYE_WORKER_THREADS=2               # CPU threads per worker (keeps the PC responsive)
OCEANEYE_WORKER_SENSITIVITY=medium      # low | medium | high (experimental presets)
OCEANEYE_WORKER_CLIP_MAX_WIDTH=0        # 0 = auto; width of stored evidence-clip frames
OCEANEYE_MAX_UPLOAD_MB=500

# Risk engine experimental parameters: intentionally unset. Decide through experiments.
# OCEANEYE_RISK_PERSISTENCE_WINDOW_SECONDS=
